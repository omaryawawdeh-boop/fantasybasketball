# Hardwood Wire — environment settings.
# Copy this file to .env.local and fill in what you want. Everything is optional:
# with no settings at all the app runs on free, keyless sources.
# .env.local is git-ignored. Never commit real keys.

# ---------------------------------------------------------------------------
# Data mode
#   auto (default) live sources; if a source has never worked since the server started,
#                  clearly labeled fictional demo data fills in so the app is still usable.
#   live           live sources only; failures show as "unavailable".
#   demo           fictional demo data only (no network). Good for trying the UI offline.
# ---------------------------------------------------------------------------
DATA_MODE=auto

# ---------------------------------------------------------------------------
# AI analyst (optional). Pick ONE provider. Keys stay on the server.
# ---------------------------------------------------------------------------

# Option A — Groq (free tier, no credit card; OpenAI-compatible). Get a key at console.groq.com
# AI_PROVIDER=groq
# AI_API_KEY=gsk_...
# AI_MODEL=            # copy a current model id from console.groq.com/docs/models

# Option B — Google Gemini (free tier; note: free-tier prompts may be used by Google to improve products)
# AI_PROVIDER=gemini
# AI_API_KEY=...
# AI_MODEL=            # a current "flash" model id from ai.google.dev

# Option C — OpenRouter (has some free models; OpenAI-compatible)
# AI_PROVIDER=openrouter
# AI_API_KEY=sk-or-...
# AI_MODEL=            # a model id from openrouter.ai/models (ids ending in ":free" cost nothing)

# Option D — Ollama on your own computer (free, private, slower; needs a decent machine)
# AI_PROVIDER=ollama
# AI_MODEL=llama3.2    # any model you've pulled with `ollama pull`
# AI_BASE_URL=http://localhost:11434/v1

# Option E — Anthropic Claude (paid, pay-as-you-go; best answer quality)
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# AI_MODEL=claude-opus-5-5   # default. claude-haiku-5-5 is far cheaper if you want to stay well under budget.

# Any other OpenAI-compatible endpoint:
# AI_PROVIDER=openai-compatible
# AI_BASE_URL=https://example.com/v1
# AI_API_KEY=...
# AI_MODEL=...

# ---------------------------------------------------------------------------
# Video (optional)
# ---------------------------------------------------------------------------
# YouTube Data API key (free quota). Only used to check whether each video allows embedding,
# so blocked videos show "watch on YouTube" up front instead of a player that refuses to play.
# YOUTUBE_API_KEY=

# Extra YouTube channels to pull highlights from (channel ids start with "UC"), comma-separated.
# They are labeled as third-party video. Pick channels whose uploads you trust.
# YOUTUBE_CHANNEL_IDS=

# Turn off individual news feeds by id (see Settings → Data sources), comma-separated.
# DISABLED_SOURCES=nbcsports,realgm
