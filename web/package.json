    "fixtures": "node scripts/make-fixtures.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.137.0",
    "fast-xml-parser": "^5.11.2",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "swr": "^2.5.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.4"
  },
  "description": "Hardwood Wire: a personal NBA news, highlights, injuries, scores and stats feed."
